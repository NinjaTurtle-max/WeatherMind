# ⚠️ 시크릿 위생(SPRINT_R11_01 §7.0): `changeme` 계열 placeholder는 그대로 두면
# 비-dev 기동이 거부된다(fail-fast). 실값 생성: openssl rand -hex 32

# ── PostgreSQL ──
POSTGRES_USER=weathermind
# 생성: openssl rand -hex 32 — 변경 시 아래 DATABASE_URL의 비밀번호도 함께 교체.
POSTGRES_PASSWORD=changeme
POSTGRES_DB=weathermind

# ── RLS 롤 분리 — 3채널 (R13 CO-J-2 · CO-Q-1) ──
# ⚠️ **비-dev(DEV_MODE=false)에서는 아래 3줄이 이 형태여야 backend가 뜬다.**
# main.py lifespan이 런타임 롤을 검사해 **특권 롤(superuser·BYPASSRLS)이면 기동을
# 거부**한다 — 소유자 롤로 붙으면 RLS 2층 격리가 조용히 무력화되기 때문이다.
#
#   ① 런타임  = 앱 롤(NOBYPASSRLS)  → RLS 정책을 실제로 받는다
#   ② 마이그레이션 = 소유자 롤        → DDL
#   ③ celery 배치  = 소유자 롤        → 정의상 전 유저 횡단이라 RLS를 우회해야 한다
#
# ③이 없으면 celery가 앱 롤로 붙어 **정산·재보정이 0행인데 성공 로그를 남긴다**
# (CO-Q-1 실측: app 롤에서 quiz_logs 0 / 소유자 롤에서 119).
# 해석 순서는 CELERY_DATABASE_URL → MIGRATION_DATABASE_URL → DATABASE_URL이라,
# ②만 제대로 채우면 ③은 자동으로 따라온다.
#
# 앱 롤은 init.sql이 만든다(dev 비번 weathermind_app_dev).
# ⚠️ **운영 배포 전 `ALTER ROLE weathermind_app PASSWORD '…'`로 교체할 것**
#    — 지금 값은 공개 저장소에 평문으로 있다(CO-Q-11).
DATABASE_URL=postgresql+asyncpg://weathermind_app:weathermind_app_dev@postgres:5432/weathermind
MIGRATION_DATABASE_URL=postgresql+asyncpg://weathermind:changeme@postgres:5432/weathermind
# 미설정 시 MIGRATION_DATABASE_URL로 폴백하므로 보통 비워 둔다.
# CELERY_DATABASE_URL=postgresql+asyncpg://weathermind:changeme@postgres:5432/weathermind
#
# ⚠️ 로컬 dev(DEV_MODE=true)에서 롤 분리 없이 쓰려면 위 두 줄을 지우고
#    DATABASE_URL=postgresql+asyncpg://weathermind:changeme@postgres:5432/weathermind
#    한 줄로 되돌린다(종전 동작 — 기동 거부는 비-dev에서만 작동한다).

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT ──
# 생성: openssl rand -hex 32
JWT_SECRET_KEY=changeme-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── 기상청 API ──
KMA_API_KEY=발급받은_서비스키
KMA_VILAGE_FCST_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getVilageFcst
KMA_MID_LAND_FCST_URL=https://apis.data.go.kr/1360000/MidFcstInfoService/getMidLandFcst
KMA_ASOS_DALY_URL=https://apis.data.go.kr/1360000/AsosDalyInfoService/getAsosDalyInfoList

# ── AI 모델 ──
GEMINI_API_KEY=발급받은_키
GEMINI_MODEL=gemini-3.1-flash-lite
# 임베딩 키는 없다. 피드백 체인이 벡터 검색을 쓰지 않고 concept_tag로
# database/seed/climate_concepts.json을 직접 조회한다 (docs/specs/03 §3).

# ── 내부 서비스 간 통신 ──
AI_WORKER_INTERNAL_URL=http://ai-worker:8001
# 생성: openssl rand -hex 32 — backend↔ai-worker↔celery가 같은 값을 공유해야 한다.
AI_WORKER_INTERNAL_API_KEY=changeme-internal-secret

# ── 기능 플래그 (R5-01 §3.4) ──
# 구름 에너지: true면 문항 시도가 구름 1 소모(20분당 1 회복, 0이면 429 OUT_OF_CLOUDS).
# false면 무제한(소모 없음) — 기존 동작, 데모·테스트 유연성. 장애 시 비활성 스위치.
ENERGY_ENABLED=true
# 개발자 모드 (R7-03): true면 /api/v1/dev 라우터(자기 계정 상태 진단·θ/구름/스트릭/
# 커리큘럼 조작·데이터 리셋)가 열린다. 개발 전용 — 운영 금지(기본 false 유지).
DEV_MODE=false
# 인증 레이트리밋 (R13 4일차 하드닝): 로그인·회원가입·게스트 시작의 IP당 한도.
# 기본 30/minute — 심사장·교실은 NAT 뒤 단일 공인 IP라 한 교실(≈30인)이 1분 안에
# 전원 진입할 수 있어야 한다. 대규모 시연이면 올린다.
# LIMIT_AUTH=30/minute
# X-Forwarded-For 첫 홉을 클라이언트 원 IP로 신뢰할지. 기본 true(Caddy 뒤 배포 전제).
# ⚠️ 프록시 뒤에서 false로 두면 전 유저가 한 버킷에 묶인다 — 백엔드를 인터넷에
# 직접 노출할 때만 끈다(그때는 켜 두면 헤더 위조로 한도가 무력화된다).
# TRUST_PROXY_HEADERS=true
# board_engine 규칙 파일 경로 override (미지정 시 database/seed/board_rules.json).
# BOARD_RULES_PATH=
# ai-worker 기후 개념 시드 경로 override (미지정 시 database/seed/climate_concepts.json).
# CLIMATE_CONCEPTS_PATH=

# ── 밸런스 튜닝 (R5.5, 재배포 없이 조정) ──
# 여기 적힌 값은 **backend/app/core/config.py Settings의 기본값과 같아야 한다** —
# 8/17 이후 "코드는 동결하고 env만 조정"하는 계획이 이 파일을 출발점으로 삼기
# 때문이다. 실제로 SESSION_RECIPE가 합 5(구버전)로 남아 있어, 그대로 복사했다면
# 세션이 15문항이 아니라 5문항이 됐다(CO-Q-9).
# 드리프트는 backend `tests/test_ci_workflow_contract.py`(TestEnvExampleContract)가 감시한다.
# 아래를 주석 해제해 override.
#
# 세션 배합(kind→개수, JSON). 총 문항 수는 합에서 파생 — 현재 계약 15문항.
# SESSION_RECIPE={"new":5,"review":4,"live":1,"unit":5}
# 커리큘럼 유닛 세션 문항 수.
# UNIT_SESSION_SIZE=5
# daily 세션 비진도 블록(10문항)의 board 상한 — 시드 비중 16%를 적용한 값(CO-H5).
# 0으로 두면 board가 daily에서 사라진다(보드 탭·진도 블록에는 그대로 나온다).
# DAILY_BOARD_CAP=2
# 구름 에너지 경제: 만렙·회복주기(분)·시도당 소모.
# CLOUD_MAX=5
# CLOUD_REGEN_MINUTES=20
# CLOUD_COST=1
# 배치고사(진단 퀴즈) 문항 수 (R7-01 §3.1, 기본 6 = CONCEPT_TAGS 6개념당 1문항).
# PLACEMENT_SIZE=6
# 분반 리더보드 (R13-01 §2.8): 소집단 인원 · 이웃 표시 범위(위아래 n명).
# LEAGUE_DIVISION_SIZE=30
# LEAGUE_NEIGHBOR_SPAN=3
# 생성 문항 영속화 상태 (R13 A-1/D): 'active'면 다음 세션부터 뱅크로 재사용되고,
# 'draft'면 저장만 하고 재출제하지 않는다(사람 검수 후 승격 전제). 그 둘만 허용.
# GENERATED_ITEM_STATUS=active

# ── DB 자동백업 (docker-compose.yml backup 서비스 — R11-01 §7.0) ──
# 기본값 = compose 기본(일 1회·최신 7개 보존). 주석 해제해 override.
# BACKUP_INTERVAL_SEC=86400
# BACKUP_KEEP=7

# ── prod 오버레이 (docker-compose.prod.yml — R11-01 §7.0 HTTPS/TLS) ──
# 실도메인을 주면 Caddy auto-HTTPS(Let's Encrypt), 미설정이면 localhost internal TLS(자체 서명).
# DOMAIN=example.com

# ── 프론트엔드 (빌드 타임) ──
VITE_API_BASE_URL=/api/v1

# ── LLM 프로바이더 라우팅 (CO-B7) ──────────────────────────────────────────
# 아무것도 설정하지 않으면 **종전 Gemini 그대로** 동작한다(하위호환).
# 용도별 오버라이드가 전역보다 우선한다: LLM_<PURPOSE>_* → LLM_* → GEMINI_*
#   PURPOSE = AUTHOR(저작 배치) · VALIDATE(2단 게이트) · RUNTIME(피드백)
#
# 하이브리드 예 — 저작만 gpt-oss로, 런타임은 Gemini 유지:
# LLM_AUTHOR_PROVIDER=openai
# LLM_AUTHOR_MODEL=openai/gpt-oss-120b
# LLM_AUTHOR_BASE_URL=https://openrouter.ai/api/v1
# LLM_AUTHOR_API_KEY=
#
# 로컬 Ollama 예(키 불필요 — base_url만 있으면 사용 가능으로 본다):
# LLM_AUTHOR_PROVIDER=openai
# LLM_AUTHOR_MODEL=gpt-oss:20b
# LLM_AUTHOR_BASE_URL=http://localhost:11434/v1

# ── LLM 서빙 모드와 지출 상한 ──────────────────────────────────────────────
# **기본이 dummy다. 배포·콜드스타트는 이 상태로 나간다.**
# 이유: 키 하나를 저작 배치용으로 넣으면 런타임 피드백도 **같이 켜진다**(세 용도가
# 같은 키로 떨어지므로). 지금 서비스가 안전한 것은 "키가 없어서"일 뿐 의도가 아니다.
# 여기서 키를 넣는 것과 **서빙에 쓰는 것을 분리**한다 — 켜는 쪽이 명시적 행위가 된다.
#   dummy = 런타임이 LLM을 아예 안 부른다(사람 저작 해설·정적 문구로 서빙)
#   live  = 상한 안에서 부른다. G2 데모 게이트에서만 켠다.
# ⚠️ 저작·검증 배치(AUTHOR·VALIDATE)는 이 값에 **안 막힌다** — G1 배치를 돌려야 한다.
LLM_SERVING_MODE=dummy

# 서비스 **전체** 누적 상한(유저별 아님). 달러로 세는 이유: 모델마다 단가가 달라
# 토큰 상한은 뜻이 흐려진다. "최대 $5"가 곧이곧대로 참이어야 한다.
# 목적은 아껴 쓰기가 아니라 **최대 손실을 확정**하기다(실측 예상은 전 기간 $0.23).
# 막으려는 것: 재시도 루프 폭주 · 무인 기간(URL을 9월 셋째 주까지 유지) · 키 유출 피해 상한.
LLM_BUDGET_TOTAL_USD=5.0
LLM_BUDGET_DAY_USD=1.0

# 상한을 넘으면 강등한다: live → fallback → 정적 문구.
# 폴백을 안 주면 곧장 정적 문구로 간다(그것도 정상 동작이다 — 무키 폴백이 이미 있다).
# LLM_RUNTIME_FALLBACK_MODEL=openai/gpt-oss-120b
# LLM_RUNTIME_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# LLM_RUNTIME_FALLBACK_API_KEY=
